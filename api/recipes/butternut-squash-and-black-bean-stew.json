  "steps": [
    {
      "text": "Heat oil over medium heat in a large pot. Cook onion and garlic in hot oil for 4 minutes or until tender. Stir in squash, undrained canned diced tomatoes, broth,  cumin.",
      "group": null
    },
    {
      "text": "Simmer, covered, for 30 minutes or until squash is tender. Stir in undrained canned seasoned black beans. Cook for 5 more minutes or until heated through. Serve over hot cooked rice. If desired, sprinkle with cilantro and lime juice.",
      "group": null
    }
  ],
  "footnotes": [],
  "nutrition": null,
  "importedNotes": [
    {
      "text": "You may want to drain off and reserve some of the broth. The rice absorbs a lot of the fluid so you may want to add the broth back in for second servings."
