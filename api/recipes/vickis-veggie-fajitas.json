  "steps": [
    {
      "text": "Over medium heat, sauté olive oil and garlic in a large frying pan for 2 minutes.",
      "group": null
    },
    {
      "text": "Stir in bell peppers and let them sauté for 2 minutes before stirring in the onions.",
      "group": null
    },
    {
      "text": "After 2 more minutes, stir in the mushrooms and green onions.",
      "group": null
    },
    {
      "text": "Season the vegetables with lemon pepper to taste and stir well.",
      "group": null
    },
    {
      "text": "Cover the frying pan and cook until all vegetables are tender.",
      "group": null
    },
    {
