  "steps": [
    {
      "text": "In a food processor pulse macadamia nuts, salt, and baking soda until the texture of gravel",
      "group": null
    },
    {
      "text": "Pulse in chocolate and coconut oil until smooth",
      "group": null
    },
    {
      "text": "Pulse in erythritol, eggs, and stevia",
      "group": null
    },
    {
      "text": "Transfer mixture to a greased 8 x 8 inch baking dish",
      "group": null
    },
    {
      "text": "Bake at 350° for 22-27 minutes, batter will set up when cooled",
      "group": null
    },
    {
      "text": "Cool 1 hour and serve",
      "group": null
    }
