  "steps": [
    {
      "text": "Place the ingredients in the order listed in a wife-mouth, pint sized mason jar.",
      "group": null
    },
    {
      "text": "Place the immersion blender at the bottom of the jar.",
      "group": null
    },
    {
      "text": "Turn the blender on and bery slowly move it to the top of the jar. Be patient. It should take you about a minute to reach the top.",
      "group": null
    },
    {
      "text": "Moving the blender slowly is the key to getting the mayonnaise to emulsify.",
      "group": null
    },
    {
      "text": "Store in the fridge for up to 5 days.",
      "group": null
    },
    {
      "text": "Option:",
      "group": null
    },
    {
      "text": "Replace the MCT oil with melted but not hot bacon fat and omit the ½ tsp salt. Taste the mayo and add salt if needed (it may be salty enough from the bacon fat).",
      "group": null
    }
