  "steps": [
    {
      "text": "Preheat oven to 350 degrees.",
      "group": null
    },
    {
      "text": "Keep dough refrigerated until ready to use.",
      "group": null
    },
    {
      "text": "Slice dough in ¼ inch slices for bottom.",
      "group": null
    },
    {
      "text": "Spread parchment paper on cookie sheet.",
      "group": null
    },
    {
      "text": "Place slices on paper, allowing 2 inches between cookies.",
      "group": null
    },
    {
      "text": "Place chocolate cookie in center of bottom cookie slice.",
      "group": null
    },
    {
      "text": "Slice dough in ¼” slices to cover top of chocolate cookie.",
      "group": null
    },
    {
      "text": "Bake for 13 minutes. Do not wait for top to brown.",
      "group": null
    },
    {
      "text": "While still semi- hot, brush centers of cookies with egg white.",
      "group": null
    },
    {
      "text": "Decorate by sprinkling a light layer of desired topping over center of cookie.",
      "group": null
    }
  ],
