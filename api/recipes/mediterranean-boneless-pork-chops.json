  "steps": [
    {
      "text": "Preheat oven to 450 degrees. Season the pork chops with Montreal",
      "group": null
    },
    {
      "text": "seasoning (or any seasoned salt you like).",
      "group": null
    },
    {
      "text": "To Julienne the Zucchini and Yellow Squash: slice the zucchini into",
      "group": null
    },
    {
      "text": "1/8-inch thick slices. Cut the slices lengthwise into 1/8-inch thick",
      "group": null
    },
    {
      "text": "strips.",
      "group": null
    },
    {
      "text": "Toss the tomatoes with 1/2 tbsp of the olive oil, 1/8 tsp salt, pepper,",
      "group": null
    },
    {
      "text": "and oregano.  Place tomatoes, cut side up, on a baking sheet lightly",
      "group": null
    },
    {
      "text": "sprayed with cooking spray; roast for 10 minutes.",
      "group": null
    },
    {
      "text": "Add sliced garlic and roast for another 5 minutes (this will prevent",
      "group": null
    },
    {
      "text": "the garlic from burning).",
      "group": null
    },
    {
      "text": "Transfer to a large work bowl and set aside.",
      "group": null
    },
    {
      "text": "Reduce oven to 200°F.",
      "group": null
    },
    {
      "text": "Heat a large non-stick skillet over medium-high heat, add remaining",
      "group": null
    },
    {
      "text": "1/2 tablespoon of olive oil and zucchini with 1/8 tsp salt and sauté",
      "group": null
    },
    {
      "text": "until tender, about 5 minutes.",
      "group": null
    },
    {
      "text": "Add to bowl with tomatoes and place in the warm oven.",
      "group": null
    },
    {
      "text": "Working in two batches, spray the skillet with cooking spray and",
      "group": null
    },
    {
      "text": "cook half of the the pork chops on medium-high heat for about 1 1/2",
      "group": null
    },
    {
      "text": "to 2 minutes on each side.  The pork chops are thin so you don’t want",
      "group": null
    },
    {
      "text": "to over cook them or they will be tough.  Set aside on a platter.",
      "group": null
    },
    {
      "text": "Remove the vegetables from the oven toss with Kalamata olives,",
      "group": null
    },
    {
      "text": "juice of lemon and lemon rind.",
      "group": null
    },
    {
      "text": "Serve the vegetables over the pork chops and top with Feta cheese.",
      "group": null
    },
    {
      "text": "Yield: 4 Servings, Serving Size: 2 chops, 3/4c veggies",
      "group": null
    }
  ],
