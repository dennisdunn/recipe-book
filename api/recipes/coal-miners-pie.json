  "steps": [
    {
      "text": "Preheat oven to moderate (350 degrees).",
      "group": null
    },
    {
      "text": "Brown beef and onions in Dutch oven or large kettle, breaking up meat with a wooden spoon and cooking until no longer pink.",
      "group": null
    },
    {
      "text": "Stir in tomato sauce, green pepper, corn, chili powder, salt and pepper.",
      "group": null
    },
    {
      "text": "Bring to boiling, lower heat, cover, and simmer for 15 minutes.",
      "group": null
    },
    {
      "text": "Pour meat mixture into ungreased 10 inch deep pie plate.",
      "group": null
    },
    {
      "text": "Spread Jiffy cornbread batter over top of meat. Spread evenly to cover entire surface. (Some of the mixture may run into the meat, but it will rise during baking).",
      "group": null
    },
    {
      "text": "Bake in preheated moderate oven for 20 minutes or until toothpick inserted into the cornbread comes out clean.",
      "group": null
    }
  ],
