  "steps": [
    {
      "text": "Scrub carrots and parsnips; peel one of each and cut into half-inch dice. Roughly chop the rest.",
      "group": null
    },
    {
      "text": "Peel sweet potato; roughly chop. Tie bay leaves, parsley stalks and thyme into a bunch with string.",
      "group": null
    },
    {
      "text": "Pour oil in saute pan over medium-high heat. Add roughly chopped vegetables and onion; shallow-fry and stir for about 3 minutes. Add garlic; fry and stir for 1 more minute.",
      "group": null
    },
    {
      "text": "Add 1 1/2 cups vegetable stock and bunch of herbs. Simmer until softened, 15 to 20 minutes; remove herbs. While simmering, add diced carrots and parsnips and remaining stock to a saucepan; simmer until just cooked, about 12 minutes.",
      "group": null
    },
    {
      "text": "Whiz onion mixture in blender until smooth. Pour into another saucepan.",
      "group": null
    },
    {
      "text": "For velvet sauce, take 1 cup of blended onion mixture; return it to blender. Add evaporated skim milk. Blend on high until glossy (at least 2 minutes). Pour into gravy boat.",
      "group": null
    },
    {
      "text": "Stir diced vegetables into blended mixture; season to taste. Serve dusted with chopped parsley and with velvet sauce on the side, as a topper.",
      "group": null
    }
  ],
