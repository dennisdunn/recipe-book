  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease a 9x13 inch baking dish.",
      "group": null
    },
    {
      "text": "In a large bowl, mix hash browns, ham, cream of potato soup, sour cream, and Cheddar cheese. Spread evenly into prepared dish. Sprinkle with Parmesan cheese.",
      "group": null
    },
    {
      "text": "Bake 1 hour in the preheated oven, or until bubbly and lightly brown. Serve immediately.",
      "group": null
    },
    {
      "text": "Cover the top with foil toward the end of baking to prevent the cheese from becoming hard.",
      "group": null
    },
    {
      "text": "NOTE: Omit the ham for a delicious side dish to a ham dinner.",
      "group": null
    }
  ],
