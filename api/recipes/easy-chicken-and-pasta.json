  "steps": [
    {
      "text": "Heat oil and lemon juice in a large skillet over medium heat",
      "group": null
    },
    {
      "text": "Cut chicken into pieces and add to skillet, cook over medium high heat until nicely browned.",
      "group": null
    },
    {
      "text": "Add onion and garlic and cook on medium heat until onion is tender and chicken is no longer pink inside.",
      "group": null
    },
    {
      "text": "Add mushrooms and tomatoes to skillet and simmer on low 10 to 15 minutes.",
      "group": null
    },
    {
      "text": "Season to taste and serve over spaghetti",
      "group": null
    },
    {
      "text": "Season to taste with basil, black pepper, paprika.",
      "group": null
    }
  ],
