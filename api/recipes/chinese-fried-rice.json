  "steps": [
    {
      "text": "Season the ground chicken with the soy sauce, sesame oil, and white pepper.",
      "group": null
    },
    {
      "text": "Heat the vegetable oil in a skillet over medium heat. Stir in the onion and garlic and cook until fragrant. Toss in the ground chicken and mushroom. Cook and stir until the chicken is crumbly, evenly browned, and no longer pink. Stir in the dark soy sauce, green onions, and rice. Cook and stir until the rice is evenly coated with the sauce. Pour the eggs over the rice, stirring until the eggs are no longer runny.",
      "group": null
