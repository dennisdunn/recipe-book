  "steps": [
    {
      "text": "In a large skillet, heat the olive oil over high heat. Stir in the steak and season with salt and pepper. Cook until beef is almost completely browned.",
      "group": null
    },
    {
      "text": "Stir in onions and broccoli, saute until tender. Add and orange sauce.",
      "group": null
    },
    {
      "text": "Reduce heat and simmer for 30 minutes or cook to desired doneness.",
      "group": null
    },
    {
