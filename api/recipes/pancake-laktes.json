  "steps": [
    {
      "text": "Grate 3 large russet potatoes and 1 small onion in a food processer using the shredding disk.",
      "group": null
    },
    {
      "text": "Drain in a colander and add to a large mixing bowl with 1 egg, 2 tablespoons flour, 1/2 teaspoon baking powder, a handful of shredded carrots and zucchini",
      "group": null
    },
    {
      "text": "salt and pepper to taste",
      "group": null
    },
    {
      "text": "Fry large dollops of the mix in vegetable oil (flattening with a spoon) for about 4 minutes a side and serve warm with sour cream and apple sauce.",
      "group": null
    }
