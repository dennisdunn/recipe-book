  "steps": [
    {
      "text": "Preheat oven to 350 degrees.",
      "group": null
    },
    {
      "text": "Mix chicken, green chilies, tomato, onion and garlic in s large skillet over medium high heat.",
      "group": null
    },
    {
      "text": "Heat until mixture starts to boil",
      "group": null
    },
    {
      "text": "Cover, reduce heat to low and simmer 5 – 6 minutes.",
      "group": null
    },
    {
      "text": "Warm each tortilla separately in a dry skillet over medium-high heat.",
      "group": null
    },
    {
      "text": "Spread 1/3 cup chicken mixture down center of each tortilla.",
      "group": null
    },
    {
      "text": "Roll tortillas and arrange seam sides down in a baking dish.",
      "group": null
    },
    {
      "text": "Pour enchilada sauce over all.",
      "group": null
    },
    {
      "text": "Sprinkle with the cheese.",
      "group": null
    },
    {
      "text": "Bake uncovered 20 – 30 minutes or until cheese is bubbling.",
      "group": null
    }
