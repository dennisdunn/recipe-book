  "steps": [
    {
      "text": "Peel the cucumbers (or not, or partially for decoration) and thinly slice into a glass bowl. Salt the slices and let sit about 1/2 hour. Rinse and drain.",
      "group": null
    },
    {
      "text": "Add the water, vinegar, sugar and sliced onion (and scallions, if using). Stir well.",
      "group": null
    },
    {
      "text": "Pack into large containers, preferably glass, and refrigerate. You can start eating it the next day; under refrigeration it lasts at least 1 week.",
      "group": null
    }
