  "steps": [
    {
      "text": "Layer a small portion of the shredded cabbage in serving bowl.",
      "group": null
    },
    {
      "text": "Layer a portion of sliced onion over cabbage.",
      "group": null
    },
    {
      "text": "Sprinkle 1/4 cup of the sugar over the onion.",
      "group": null
    },
    {
      "text": "Continue layering cabbage, onion and sugar. Use entire amount.",
      "group": null
    },
    {
      "text": "Heat oil, vinegar, 1/2 cup sugar, celery seed, salt and prepared mustard over low heat until sugar is dissolved.",
      "group": null
    },
    {
      "text": "Pour over cabbage mixture. DO NOT STIR.",
      "group": null
    },
    {
      "text": "Leave untouched and cover tightly.",
      "group": null
    },
    {
      "text": "Refrigerate for 24 hours.",
      "group": null
    },
    {
      "text": "Mix when ready to serve.",
      "group": null
    }
