  "steps": [
    {
      "text": "Heat oil in skillet. Add onion and cook til lightly browned.",
      "group": null
    },
    {
      "text": "Add garlic and cook for an additional minute.",
      "group": null
    },
    {
      "text": "Add meat, diced tomatoes, beans and chicken bouillon, stir to combine.",
      "group": null
    },
    {
      "text": "Reduce heat to medium, cover and cook for 8-10m minutes.",
      "group": null
    },
    {
      "text": "Stir in Tortilla chips, cook for 5 minutes.",
      "group": null
    },
    {
      "text": "Add cheese and cook for an additional minute.",
      "group": null
    },
    {
      "text": "Sprinkle with cilantro and serve.",
