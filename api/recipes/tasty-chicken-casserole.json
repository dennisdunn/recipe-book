  "steps": [
    {
      "text": "Sautee veggies until al dente, stir in chicken to impart flavor to chicken.",
      "group": null
    },
    {
      "text": "Place in 13-in. x 9-in. x 2-in. baking dish.",
      "group": null
    },
    {
      "text": "Sprinkle ½ cup of cheese over chicken and veggies.",
      "group": null
    },
    {
      "text": "Prepare stuffing according to package directions and spread over chicken mixture.",
      "group": null
    },
    {
      "text": "Combine soup, milk and parsley and pour over chicken and stuffing.",
      "group": null
    },
    {
      "text": "Spread remaining ¾ cup cheese over top. (Optional: combine with bread crumbs)",
      "group": null
    },
    {
      "text": "Cover and bake at 400 degrees F for 20 to 30 minutes.",
      "group": null
    }
