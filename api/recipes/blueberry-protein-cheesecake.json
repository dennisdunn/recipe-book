  "steps": [
    {
      "text": "Preheat oven to 350 degrees F.",
      "group": null
    },
    {
      "text": "Combine crust ingredients to form a crumbly mixture that sticks to itself (add 1 tbsp. water if mixture is too dry).",
      "group": null
    },
    {
      "text": "Lightly coat a 8\" or 9\" pan with cooking spray and press crust mixture into bottom.",
      "group": null
    },
    {
      "text": "Bake for 10 minutes and set aside.",
      "group": null
    },
    {
      "text": "Reduce oven temperature to 300 degrees F.",
      "group": null
    },
    {
      "text": "Meanwhile, blend together cream cheese and yogurt until smooth.",
      "group": null
    },
    {
      "text": "Add egg whites, protein powder, sweetener, and vanilla; blend again until smooth.",
      "group": null
    },
    {
      "text": "Pour cheesecake mixture into pan over baked crust.",
      "group": null
    },
    {
      "text": "Mash berries (thaw in microwave if frozen) and stir in sweetener to taste.",
      "group": null
    },
    {
      "text": "Drop berry mixture over cheesecake one tablespoon at a time, then swirl through with a knife.",
      "group": null
    },
    {
      "text": "Bake for 25-35 minutes until center is set. Cracking indicates over-baking.",
      "group": null
    },
    {
      "text": "Let cheesecake cool at room temperature for 10-15 minutes, then chill in fridge for a minimum of 3 hours or overnight.",
      "group": null
    },
    {
      "text": "Cut into eight pieces and enjoy! Store in fridge up to one week.",
      "group": null
    }
  ],
