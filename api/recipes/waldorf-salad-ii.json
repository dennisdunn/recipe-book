  "steps": [
    {
      "text": "Dice apples with skin still on. Place in a bowl of water with a little lemon juice to keep them from turning brown preparing other ingredients..",
      "group": null
    },
    {
      "text": "In a large bowl, whisk together the mayonnaise, sugar, lemon juice and orange juice. Fold in the whipped cream.",
      "group": null
    },
    {
      "text": "Drain the apples and add to the mayonnaise mixture, along with the celery, walnuts and raisins. Stir until ingredients are evenly coated.",
      "group": null
    },
    {
      "text": "Sprinkle with nutmeg and chill before serving.",
      "group": null
    }
  ],
