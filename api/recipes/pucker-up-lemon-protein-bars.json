  "steps": [
    {
      "text": "Preheat oven to 180 degrees and grease and line a 20c20 square cake pan, put aside. Combine protein powder, almond meal, coconut flour and coconut flakes into a large bowl and whisk until well mixed. Put aside.",
      "group": null
    },
    {
      "text": "In another large bowl, beat eggs until paled and creamy. Add maple syrup, lemon juice, zest and chia seeds and continue to beat until all incorporated.",
      "group": null
    },
    {
      "text": "Turn stand mixed to lowest speed or mix by hand until just mixed. Batter should be the texture of cake batter. If too dry, add coconut milk in 1 tbsp increments until moist and thickened.",
      "group": null
    },
    {
      "text": "Pour into prepared baking dish and smooth out with back of  wooden spoon or spatula. Bake for 30 mins or until skewer comes out clean.",
      "group": null
    },
    {
      "text": "Allow to cool completely, then remove from pan and cut once horizontally and then cut each portion into 6 bars to make 12 total.",
      "group": null
    }
  ],
