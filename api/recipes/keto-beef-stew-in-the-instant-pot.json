  "steps": [
    {
      "text": "Set your Instant Pot to sauté and add the butter. Once hot, add the onion and sauté until soft, about 3 minutes.",
      "group": null
    },
    {
      "text": "Add the beef cubes, season with salt and pepper, and brown on all sides, about 5-7 minutes.",
      "group": null
    },
    {
      "text": "Add the garlic and cook until aromatic, about 1 minute.",
      "group": null
    },
    {
      "text": "Pour the red wine over top and use a wooden spatula to scrape up any browned bits.",
      "group": null
    },
    {
      "text": "Turn the Instant Pot off and add the remaining ingredients. Screw on the lid and set to High Pressure, Manual for 15 minutes.",
      "group": null
    },
    {
      "text": "Release steam when finished cooking. Remove the marrow bones, if using, and the bay leaves.",
      "group": null
    },
    {
      "text": "Serve and enjoy!",
      "group": null
    }
  ],
