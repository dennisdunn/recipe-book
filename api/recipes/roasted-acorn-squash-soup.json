  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "group": null
    },
    {
      "text": "Put squash into a baking dish with the cut side down. Pour enough water into the baking dish to cover the bottom.",
      "group": null
    },
    {
      "text": "Bake in preheated oven until the flesh of the squash is easily pricked with a fork, about 45 minutes. Remove from oven and allow to cool until squash can be handled. Scoop flesh into a bowl and set aside.",
      "group": null
    },
    {
      "text": "Melt butter in a pot over medium-high heat. Cook onion, carrot, and garlic in melted butter until soft, 5 to 7 minutes. Pour chicken stock into the pot; add the squash.",
      "group": null
    },
    {
      "text": "Bring the mixture to a simmer and cook for 20 minutes.",
      "group": null
    },
    {
      "text": "Pour mixture into a blender no more than half full. Cover and hold lid down; pulse a few times before leaving on to blend. Puree in batches until smooth and return to pot.",
      "group": null
    },
    {
      "text": "Stir half-and-half, nutmeg, and cinnamon through the blended soup; season with salt and pepper. Thin the soup with water if desired",
      "group": null
    }
  ],
  "footnotes": [],
  "nutrition": null,
  "importedNotes": [
    {
      "text": "Roasted the onion, carrots and garlic along with the squash. Combined all in a pan with the rest of ingredients and used my immersion blender from other reviews. Only roast garlic for about half an hour, then take out of oven and set aside til ready to use."
    }
