  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (150 degrees C). Grease a 9x13 inch baking pan.",
      "group": null
    },
    {
      "text": "Mix together potato soup, celery soup, (onion and green bell pepper), sour cream, and half of the cheese.",
      "group": null
    },
    {
      "text": "Pour the mixture over the potatoes, stir and transfer to baking pan.",
      "group": null
    },
    {
      "text": "Dot with butter, cover with foil and bake in the preheated 300 degrees F (150 degrees C) oven for 60 minutes.",
      "group": null
    },
    {
      "text": "Remove pan from oven, sprinkle with (*cornflakes) and remaining cheese, and bake another 30 minutes or until the cheese melts.",
      "group": null
    }
  ],
  "footnotes": [
    "Optional: Mix together 1 cup cornflakes and ½ cup melted unsalted butter and sprinkle over top, then add remaining cheese and bake uncovered until cheese has melted and cornflakes are golden brown (approx. 20 to 30 minutes)."
  ],
