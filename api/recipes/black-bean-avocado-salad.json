  "steps": [
    {
      "text": "In a large bowl, combine the first eight ingredients. In a small bowl, whisk the dressing ingredients. Pour over salad and toss to coat. Cover and refrigerate for at least 1 hour before serving. Serve over Romaine lettuce or Baby Spinach.",
      "group": null
    }
  ],
  "footnotes": [],
  "nutrition": null,
  "importedNotes": [
    {
      "text": "Substitute a can of green chilies instead of the jalapeno."
    },
    {
      "text": "Add black olives."
    },
    {
      "text": "Double the avocado and tomato, and add a teaspoon of sugar to the sauce."
    },
    {
      "text": "Substitute raw corn and red pepper instead of canned Mexicorn."
    },
    {
      "text": "Serve left over in pita bread or use as a nacho topping."
    }
