  "steps": [
    {
      "text": "Melt cocoa butter in a small sauce pan in a bath of water. (I just use another slightly bigger sauce pan, half full with water)",
      "group": null
    },
    {
      "text": "Add cocoa powder to the sauce pan.",
      "group": null
    },
    {
      "text": "Now add the Swerve and mix well until all ingredients are well blended and melted.",
      "group": null
    },
    {
      "text": "Add macadamias and stir in well.",
      "group": null
    },
    {
      "text": "Add cream, mix well and bring back to temperature.",
      "group": null
    },
    {
      "text": "Now pour in molds or paper candy cups.",
      "group": null
    },
    {
      "text": "Let cool, then put in the fridge to harden.",
      "group": null
    },
    {
      "text": "Keeps at room temperature, with a slightly softer consistency than chocolate.",
      "group": null
    }
