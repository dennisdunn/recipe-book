  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Melt the butter in a saucepan. Stir in flour to form a paste. Add water, cornstarch, white sugar, brown sugar,  cinnamon, nutmeg and vanilla and bring to a boil. Reduce temperature and let simmer.",
      "group": null
    },
    {
      "text": "Place the bottom crust in a 9” glass pie plate. Brush egg white on bottom crust (to keep crust from getting soggy).",
      "group": null
    },
    {
      "text": "Slice apples thin, mound half the apples in the pie plate, and arrange apples so there are no gaps between the slices.",
      "group": null
    },
    {
      "text": "Pour 1/3 of the sugar mixture over the apples, add the rest of the apples and pour another 1/3 of mixture over second half of apples.",
      "group": null
    },
    {
      "text": "Keep remaining sugar mixture hot so that it doesn’t thicken. If too thick, add water.",
      "group": null
    },
    {
      "text": "Cover with top crust. Baste or slowly pour remaining sugar mixture over the top crust.",
      "group": null
    },
    {
      "text": "Place pie on pizza stone on middle shelf in the oven. (Put baking tray on bottom shelf to catch drips).",
      "group": null
    },
    {
      "text": "Bake for 45 minutes to an hour, until apples are soft. If top is getting too brown, reduce heat to 250 and place pie on bottom shelf to finish cooking.",
      "group": null
    },
    {
      "text": "Allow pie to cool before serving so that apple mixture has time to thicken.",
      "group": null
    }
  ],
