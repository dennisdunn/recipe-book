  "steps": [
    {
      "text": "Preheat oven to 400 degrees.",
      "group": null
    },
    {
      "text": "In skillet, brown sausage and drain on paper towels.",
      "group": null
    },
    {
      "text": "In bowl, combine sausage, gravy, vegetables and Worcestershire.",
