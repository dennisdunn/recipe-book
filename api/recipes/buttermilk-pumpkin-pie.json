  "steps": [
    {
      "text": "Preheat oven to 350 degrees.",
      "group": null
    },
    {
      "text": "In a large bowl, combine the sugar, flour, spices and salt and mix well. Add pumpkin and mix well. Add eggs and stir to combine.",
      "group": null
    },
    {
      "text": "In a small bowl, combine buttermilk, vanilla and melted butter. Add to pumpkin mix  and stir just until combined. Pour pumpkin mix into piecrust.",
      "group": null
    },
    {
      "text": "Optional: sprinkle top with ½ of the sugar and cardamom mixture. Cover edges with foil. Bake 45 to 50 minutes or until edges are puffed and center appears set. Cool on wire racks and chill within 2 hours.",
      "group": null
    },
    {
      "text": "Optional: sprinkle with remaining mixture of 1 tbsp sugar and ½ tsp cardamom before serving.",
      "group": null
    },
    {
      "text": "Serving size 1/8 of pie: 395 calories, 19 grams fat, 106 mg cholesterol, 371 mg sodium, 52 grams carb, 2 grams fiber, 6 grams protein",
