  "steps": [
    {
      "text": "Heat oven to 425F.",
      "group": null
    },
    {
      "text": "Cut the potatoes into wedges. Toss in a bowl with olive oil, salt, pepper, and a splash of water. (For spicy mega fries, add a pinch of cayenne, paprika, and garlic salt, evenly distributed.)",
      "group": null
    },
    {
      "text": "Lay foil on a baking sheet and spray with a little cooking spray. (Crucial; the fries are hard to remove from foil otherwise.) Line up the fries in rows.",
      "group": null
    },
    {
      "text": "Bake for 25 minutes or until crispy and golden.",
      "group": null
    }
