  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "group": null
    },
    {
      "text": "Place crushed pretzels in the bottom of a 9x13 inch baking dish.",
      "group": null
    },
    {
      "text": "Pour melted butter carefully over top. Bake in preheated oven 10 minutes.",
      "group": null
    },
    {
      "text": "Cream together cream cheese and sugar.",
      "group": null
    },
    {
      "text": "Fold in whipped topping.",
      "group": null
    },
    {
      "text": "Spread over cooled crust.",
      "group": null
    },
    {
      "text": "Combine pineapple and pudding mix. Spread over whipped topping layer.",
      "group": null
    },
    {
      "text": "Chill until serving.",
      "group": null
    }
