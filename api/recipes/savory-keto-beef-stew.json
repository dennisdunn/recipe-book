  "steps": [
    {
      "text": "Set instapot to sauté and oil to coat, allow pot to warm up as you prepare the ingredients.",
      "group": null
    },
    {
      "text": "Add beef cubes and brown for 5-7 minutes, then add veggies to the mix.",
      "group": null
    },
    {
      "text": "Next, sprinkle the ranch dressing mix over the meat. Cut butter into patties and place evenly over meat.",
      "group": null
    },
    {
      "text": "In separate dish, mix broth, Worchestershire sauce, and garlic powder and then pour mixture into the crockpot.",
      "group": null
    },
    {
      "text": "Finally, place pepperoncini evenly over the top of the mixture and add salt and pepper to taste.",
      "group": null
    },
    {
      "text": "Keto Beef Stew Nutrition Facts (per serving):",
      "group": null
    },
    {
      "text": "Recipe yields 4 servings",
      "group": null
    }
  ],
