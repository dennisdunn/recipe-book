  "steps": [
    {
      "text": "Season ribs with rub.",
      "group": null
    },
    {
      "text": "Pour Pepsi into slow cooker. Layer the ribs into the slow cooker. Top the ribs with onion and garlic.",
      "group": null
    },
    {
      "text": "Cook on High for 4 hours (or Low for 8 hours).",
      "group": null
    },
    {
      "text": "Preheat oven to 350 degrees F (190 degrees C).",
      "group": null
    },
    {
      "text": "Transfer ribs to a 9x11 uncovered baking sheet covered with tin foil. Discard onion and garlic. Coat ribs with barbeque sauce.",
      "group": null
    },
    {
      "text": "Bake in preheated oven until the sauce caramelizes and sticks to the meat, 20 minutes.",
      "group": null
    },
    {
