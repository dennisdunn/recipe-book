  "steps": [
    {
      "text": "Microwave the broccoli in the open box for 2-3 minutes.",
      "group": null
    },
    {
      "text": "Put broccoli in greased 13x9 pan.",
      "group": null
    },
    {
      "text": "Put cooked cut-up chicken on top of the broccoli.",
      "group": null
    },
    {
      "text": "Mix mayo, soup, and lemon juice and pour over the chicken.",
