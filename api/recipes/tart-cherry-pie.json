  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "group": null
    },
    {
      "text": "In a large bowl, gently stir the cherries, brown sugar, and white sugar until all the sugar has dissolved.",
      "group": null
    },
    {
      "text": "Mix in the liquid pectin (for thickening), almond extract, cinnamon, and salt. Let stand 15 minutes.",
      "group": null
    },
    {
      "text": "Roll out half of pastry into a circle slightly larger than the pie plate, and place in bottom of pie plate.",
      "group": null
    },
    {
      "text": "Pour filling into pie plate, and dot with butter.",
      "group": null
    },
    {
      "text": "Roll out top crust pie slightly larger than the pie plate, cut into wide lattice strips and place over the cherries. Seal lattice where it overlaps bottom crust, and brush with milk.",
      "group": null
    },
    {
      "text": "Bake 45 minutes in the preheated oven, until crust is browned and filling is bubbly.",
      "group": null
    },
    {
      "text": "Cool 1 hour before serving.",
      "group": null
    }
  ],
