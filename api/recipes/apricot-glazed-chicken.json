  "steps": [
    {
      "text": "Whisk together soy sauce, vegetable oil, vinegar, garlic, ginger, salt, red pepper and apricot jam to make a marinade.",
      "group": null
    },
    {
      "text": "Place chicken in sealable plastic bag and pour marinade over the chicken.",
      "group": null
    },
    {
      "text": "Marinate in the refrigerator for at least one hour.",
      "group": null
    },
    {
      "text": "Remove chicken from marinade.",
      "group": null
    },
    {
      "text": "Grill chicken for approx. 6 minutes on each side, basting with leftover marinade until the chicken reaches internal temperature of 165 degrees.",
      "group": null
    },
    {
      "text": "Refrigerate any leftovers.",
      "group": null
    }
