  "steps": [
    {
      "text": "Preheat oven to 350 degrees.",
      "group": null
    },
    {
      "text": "Grease 13” by 9” baking pan.",
      "group": null
    },
    {
      "text": "Into large bowl, measure all ingredients except the confectioners’ sugar.",
      "group": null
    },
    {
      "text": "With mixer on low speed, beat ingredients until well blended, constantly scraping bowl with rubber spatula.",
      "group": null
    },
    {
      "text": "Pour batter into pan.",
      "group": null
    },
    {
      "text": "Bake 40 to 45 minutes until toothpick comes out clean.",
      "group": null
    },
    {
      "text": "Cool cake in pan on wire rack for 10 minutes.",
      "group": null
    },
    {
      "text": "Remove cake from pan and cool completely on wire rack.",
      "group": null
    },
    {
      "text": "If desired, sprinkle powdered sugar on top before serving.",
      "group": null
    },
    {
      "text": "Makes 16 servings, 275 calories per serving.",
