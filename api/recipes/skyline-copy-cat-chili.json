  "steps": [
    {
      "text": "Brown ground beef and onion, drain.",
      "group": null
    },
    {
      "text": "Add beef stock to beef mixture and simmer 10 minutes.",
      "group": null
    },
    {
      "text": "Add remaining 13 ingredients, simmer uncovered 1 hour.",
      "group": null
    },
    {
      "text": "Remove bay leaf, skim off extra fat.",
      "group": null
    },
    {
      "text": "Serve over hot spaghetti, or hot dogs in buns for chili dogs.",
      "group": null
    },
    {
      "text": "Top with plenty of cheese and other optional toppings.",
      "group": null
    },
    {
      "text": "I used 1 lb ground beef and 1 lb ground pork and it tasted great.",
      "group": null
    },
    {
      "text": "If too spicy (hot), add milk and simmer until sauce is hot and right consistency.",
      "group": null
    },
    {
      "text": "Tastes as good or better than skyline!",
      "group": null
    }
