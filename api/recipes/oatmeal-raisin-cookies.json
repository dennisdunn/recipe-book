  "steps": [
    {
      "text": "Combine eggs, vanilla and raisins in a small bowl; cover and let stand for 1 hour.",
      "group": null
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "group": null
    },
    {
      "text": "In a large bowl, cream the butter, brown sugar, and white sugar together. Sift together the flour, cinnamon, and baking soda; stir into the creamed mixture. Then mix in the raisin mixture, rolled oats, and nuts by hand.",
      "group": null
    },
    {
      "text": "Roll the dough into logs in plastic wrap and popped 'em in the freezer for 30 minutes, then slice and bake on parchment covered cookie sheets. Bake for 9 minutes (15 if using frozen dough) or until lightly browned. Let cool for 2 minutes before removing from pan. Yields 6 dozen.",
      "group": null
    }
  ],
  "footnotes": [],
  "nutrition": null,
  "importedNotes": [
    {
      "text": "I soaked the raisins in 2 eggs and added 1 egg to the batter for easier mixing. Soaking the raisins in the egg makes the difference, never skip this step!"
    },
    {
      "text": "I dumped a little of the egg in early because this dough is pretty stiff and it helped with the mixing."
    },
    {
      "text": "Don't make the balls too large as you drop them on the cookie sheet, or the middles will stay gooey. Keep them around a teaspoon to a teaspoon and a half."
    }
  ],
