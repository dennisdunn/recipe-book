  "steps": [
    {
      "text": "Preheat oven to 400 degrees.",
      "group": null
    },
    {
      "text": "In large skillet, sauté onion, green pepper and leftover veggies in oil until onion is tender,",
      "group": null
    },
    {
      "text": "Add tomatoes, chili powder, olives and garlic.",
      "group": null
    },
    {
      "text": "Stir occasionally, simmer 10 minutes",
      "group": null
    },
    {
      "text": "Remove from heat, stir in beans and corn.",
      "group": null
    },
    {
      "text": "Prepare cornbread mix according to directions, spread over bean mixture. (GF cornbread mix makes more than needed. Save extra batter for cornbread muffins which bake at 350 degrees).",
      "group": null
    },
    {
      "text": "Sprinkle cheese over cornbread mixture.",
      "group": null
    },
    {
      "text": "Bake for 20 minutes or until toothpick comes out clean.",
      "group": null
    },
    {
      "text": "Let stand for 10 minutes before serving.",
      "group": null
    },
    {
      "text": "557 calories, 19 grams protein, 82 grams carbs, 19 grams fat per serving.",
      "group": null
    }
