  "steps": [
    {
      "text": "Place flour in a large bowl. Cut in shortening and butter until mixture is crumbly.",
      "group": null
    },
    {
      "text": "In a separate bowl, mix together egg, sugar, salt, and lemon juice.",
      "group": null
    },
    {
      "text": "Make a well in the center of flour mixture. Pour in all of egg mixture and half of ice water.",
      "group": null
    },
    {
      "text": "Stir gently with a fork, adding more water as needed, just until mixture forms a ball.",
      "group": null
    },
    {
      "text": "Turn dough onto a floured surface and cut into 4 equal portions. Knead each piece briefly and shape into a disc.",
      "group": null
    },
    {
      "text": "Chill 1 hour before rolling out.",
      "group": null
    }
