  "steps": [
    {
      "text": "Melt butter in large skillet over medium heat. Add onions, cook and stir 15 minutes or until onions are soft and lightly browned. Stir in wine.",
      "group": "Slow Cooker Directions"
    },
    {
      "text": "Combine onion mixture, broth, Worcestershire sauce, salt and thyme in slow cooker. Cover; cook on LOW 4 to 4-1/2 hours.",
      "group": "Slow Cooker Directions"
    },
    {
      "text": "Ladle soup into 4 bowls; top with bread slice and cheese. Garnish with fresh thyme, if desired.",
      "group": "Slow Cooker Directions"
    }
  ],
