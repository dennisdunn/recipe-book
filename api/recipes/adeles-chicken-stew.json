  "steps": [
    {
      "text": "Cut chicken breasts into cubes. Combine flour, 1 tsp cornstarch and 1 tsp basil or poultry seasoning in gallon size plastic bag. Add chicken cubes and shake to coat.",
      "group": null
    },
    {
      "text": "Saute chicken cubes over medium heat until slightly browned. Remove and set aside.",
      "group": null
    },
    {
      "text": "Saute onions, carrots, celery and garlic in olive oil and a splash of white wine.",
      "group": null
    },
    {
      "text": "In a large bowl, combine chicken, soups, Cheddar cheese, mozzarella cheese, sauteed vegetables, salt (if needed) and pepper. Mix thoroughly.",
      "group": null
    },
    {
      "text": "Pour mixture into Crock Pot and simmer on low and cook for 3 to 4 hours or until all is tender and flavors have blended.",
      "group": null
    },
    {
      "text": "Slice and saute mushrooms until they just start to form a broth.",
      "group": null
    },
    {
      "text": "Add mushrooms and peas to stew about 30 minutes before stew finishes cooking.",
      "group": null
    },
    {
      "text": "Serve over Grands Buttermilk Biscuits.",
      "group": null
    },
    {
      "text": "P.S. I doubled everything in this recipe except the peas for Home Group. Large chunks of chicken and vegetables have more “presence” than the small chunks usually found in pot pies. If you make this recipe as a pot pie, thicken the broth with cornstarch and don’t use frozen vegetables or sauce will get too soupy. Brush pie crust with egg wash for a golden crust, cut vents in pie crust and bake at 350 degrees for 50 minutes.",
      "group": null
    }
  ],
