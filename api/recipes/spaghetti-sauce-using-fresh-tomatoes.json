  "steps": [
    {
      "text": "To peel tomatoes make star slits with a sharp knife at the stem end of tomatoes,    blanch them in boiling hot water for 30 seconds, shock in ice water, remove skins  and  dice.",
      "group": null
    },
    {
      "text": "In large saucepan, cook tomatoes and basil over medium-low heat until tomatoes are soft.",
      "group": null
    },
    {
      "text": "Meanwhile, in medium skillet, saute onion and garlic in olive oil until onions are translucent.",
      "group": null
    },
    {
      "text": "Add onion mixture to tomato mixture and add salt and pepper. Simmer for 20 to 30 minutes at the barest simmer to retain bright red color.",
      "group": null
    },
    {
      "text": "Sprinkle each serving with additional basil before serving.",
      "group": null
    }
