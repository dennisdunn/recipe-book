  "steps": [
    {
      "text": "Preheat oven to 350ºF.",
      "group": null
    },
    {
      "text": "Mix flour, baking powder, baking soda and oats; set aside.",
      "group": null
    },
    {
      "text": "Beat butter in large bowl with electric mixer on medium speed until light and fluffy.",
      "group": null
    },
    {
      "text": "Gradually add sugars.",
      "group": null
    },
    {
      "text": "Add egg and mix well.",
      "group": null
    },
    {
      "text": "Gradually add flour and oat mixture, beating until well blended after each addition.",
      "group": null
    },
    {
      "text": "Rub ginger pieces between your palms to remove excess sugar.",
      "group": null
    },
    {
      "text": "Add cereal and ginger pieces and stir until well blended.",
      "group": null
    },
    {
      "text": "Drop teaspoonfuls of dough, 2 inches apart, onto ungreased baking sheets.",
      "group": null
    },
    {
      "text": "Bake 12 to 14 minutes or until lighty browned.",
      "group": null
    },
    {
      "text": "Cool on baking sheets 3 to 4 minutes; remove to wire racks.",
      "group": null
    },
    {
      "text": "Cool completely.",
      "group": null
    },
    {
      "text": "Store in tightly covered container at room temperature.",
      "group": null
    }
  ],
