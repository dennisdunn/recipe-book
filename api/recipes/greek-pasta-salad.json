  "steps": [
    {
      "text": "In a large bowl, whisk together olive oil, vinegar, garlic powder, basil, oregano, black pepper, and sugar. Add cooked pasta, artichoke hearts, tomatoes, red and yellow peppers, feta cheese, onions, olives, and pepperoni. Toss until evenly coated. Cover, and chill 2 hours or overnight.",
      "group": null
    },
    {
      "text": "Leave a little dressing left over to toss right before serving.",
      "group": null
    }
