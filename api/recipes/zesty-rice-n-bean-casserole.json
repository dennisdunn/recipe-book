  "steps": [
    {
      "text": "In a large nonstick skillet, saute the green peppers, mushrooms, onion and garlic in water and oil until onion is tender. Add the tomatoes, beans, rice and seasonings. bring to a boil. Reduce heat; cover and simmer for 25 minutes or until rice is tender and most of the liquid is absorbed. Remove from the heat; stir in 1/2 cup cheese.",
      "group": null
    },
    {
      "text": "Transfer to a 2-1/2-qt. baking dish coated with nonstick cooking spray. Sprinkle with remaining cheese. bake, uncovered, at 350 degrees F for 15-20 minutes or until cheese is melted.",
      "group": null
    }
  ],
