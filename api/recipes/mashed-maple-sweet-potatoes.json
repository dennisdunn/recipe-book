  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line a baking sheet with aluminum foil.",
      "group": null
    },
    {
      "text": "Place sweet potatoes onto the prepared baking sheet, and bake in preheated oven until soft, 45 minutes to 1 hour. Remove from the oven and allow to cool slightly before peeling and placing into a large bowl.",
      "group": null
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Butter a 2 quart casserole dish.",
      "group": null
    },
    {
      "text": "Mash the warm potatoes along with butter, cream, vanilla extract, brown sugar, salt, 1/2 cup maple syrup, 1 cup chopped pecans, and eggs. Spread mashed sweet potato into the prepared baking dish, and sprinkle with the remaining 2 tablespoons of maple syrup, and 1/4 cup of pecans.",
      "group": null
    },
    {
      "text": "Bake sweet potatoes in preheated oven until thoroughly hot, 30 to 35 minutes.",
      "group": null
    }
  ],
