  "steps": [
    {
      "text": "Preheat oven to 375 F",
      "group": null
    },
    {
      "text": "Combine cream cheese, eggs, coconut oil, almond milk, and vanilla extract in one",
      "group": null
    },
    {
      "text": "bowl. Mix well, and make sure it’s smoooth.",
      "group": null
    },
    {
      "text": "Combine cocoa powder, almond flour, coconut flour, baking soda, Splenda, and salt in",
      "group": null
    },
    {
      "text": "a bowl.",
      "group": null
    },
    {
      "text": "Slowly add the wet ingredients to the dry, mixing well. Add walnuts and dates, if desired.",
      "group": null
    },
    {
      "text": "Spoon batter into no stick mini cupcake pan.",
      "group": null
    },
    {
      "text": "Bake for 10 minutes, or until",
      "group": null
    },
    {
      "text": "Pop out brownie bites using a toothpick and let cool for 5 minutes on cooling rack.",
      "group": null
    },
    {
      "text": "This makes a total of 6 servings of Delicious Chocolate Keto Brownies.",
      "group": null
    },
    {
      "text": "Each serving has 196 Calories, 17.68g Fats, 2.7g Net Carbs, and 6.13g Protein.",
      "group": null
    }
