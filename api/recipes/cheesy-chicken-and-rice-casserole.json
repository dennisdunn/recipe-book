  "steps": [
    {
      "text": "Heat oven to 350.",
      "group": null
    },
    {
      "text": "Take 2 grilled chicken breasts and allow them to slightly cool. Shred chicken breasts and place to the side in a mixing bowl.",
      "group": null
    },
    {
      "text": "Finely chop your pepper and onion and sauté in 2 Tbsp butter for 5 minutes until soft.",
      "group": null
    },
    {
      "text": "Add cream cheese into the onion and pepper and mix well.",
      "group": null
    },
    {
      "text": "Pour into the large bowl with chicken. Mix in rice, hot sauce, cream of mushroom soup, ½ cup Monterrey Jack cheese, and salt and pepper. Mix well.",
      "group": null
    },
    {
      "text": "Pour mixture in a 9 x 13 dish, and cover with remaining cheese and add salt and pepper to taste. Bake for 30 minutes. Allow to cool for 5 minutes before serving.",
      "group": null
    }
  ],
