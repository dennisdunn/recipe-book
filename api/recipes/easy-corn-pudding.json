  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Put butter in 2 quart casserole dish, place in oven until melted",
      "group": null
    },
    {
      "text": "Remove casserole dish and add creamed corn, kernel corn, muffin mix and sour cream.",
      "group": null
    },
    {
      "text": "Mix well, bake uncovered approximately 40 minutes.",
      "group": null
    }
  ],
