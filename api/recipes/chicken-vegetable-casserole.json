  "steps": [
    {
      "text": "Preheat oven to 350. Grease 9x13 glass dish.",
      "group": null
    },
    {
      "text": "Prepare the white sauce by placing the butter in a small sauce pot that has been preheated over medium heat. Once the butter foams, add flour and stir for 1 minute; try not to let the mixture turn brown.",
      "group": null
    },
    {
      "text": "Add milk to the mixture and continue to stir until it starts to bubble. Reduce heat and simmer for 10 minutes. Add pepper, Italian seasoning, cream cheese and parmesan cheese to the sauce & stir.",
      "group": null
    },
    {
      "text": "Cook pasta according to package directions. During the last minute, add the chopped broccoli to the water. Simmer for 1 min.",
      "group": null
    },
    {
      "text": "Drain the pasta and broccoli.",
      "group": null
    },
    {
      "text": "Combine the pasta and broccoli with the chicken and chopped vegetables; cover with the sauce. Sprinkle with cheese and cover with foil. Bake for 20 minutes; remove foil and continue to bake until cheese is melted.",
      "group": null
    }
  ],
