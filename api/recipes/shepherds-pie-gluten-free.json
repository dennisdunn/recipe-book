  "steps": [
    {
      "text": "Preheat oven to 400 degrees.",
      "group": null
    },
    {
      "text": "In skillet, brown sausage and drain off the grease.",
      "group": null
    },
    {
      "text": "Push sausage to far side of pan. Melt butter in close side of pan.",
      "group": null
    },
    {
      "text": "Add ¼ cup gluten free flour to the melted butter to make a paste.",
      "group": null
    },
    {
      "text": "Gradually add milk and stir the sausage back in as gravy thickens.",
      "group": null
    },
    {
      "text": "Add 2 tsp of Worcestershire Sauce to darken gravy and increase flavor.",
      "group": null
    },
    {
      "text": "While sausage gravy is thickening, microwave frozen vegetables   according to directions on bag.",
      "group": null
    },
    {
      "text": "Then add vegetables to the sausage and gravy.",
      "group": null
    },
    {
      "text": "Leave in frying pan or pour into a greased 2 quart casserole dish or large pie plate.",
      "group": null
    },
    {
      "text": "Heat mashed potatoes in microwave per instructions on package.",
      "group": null
    },
    {
      "text": "Spoon mashed potatoes on top of mixture and spread evenly.",
      "group": null
    },
    {
      "text": "Bake at 400 degrees for 30 to 40 mins or until hot and bubbly.",
      "group": null
    },
    {
      "text": "Comments: Really easy and really good. One of Grandpa Dennis’ favorites.",
      "group": null
    }
  ],
