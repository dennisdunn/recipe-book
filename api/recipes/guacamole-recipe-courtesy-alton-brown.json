  "steps": [
    {
      "text": "In a large bowl place the scooped avocado pulp and lime juice, toss to coat.",
      "group": null
    },
    {
      "text": "Drain, and reserve the lime juice, after all of the avocados have been coated.",
      "group": null
    },
    {
      "text": "Using a potato masher add the salt, cumin, and cayenne and mash.",
      "group": null
    },
    {
      "text": "Fold in the onions, tomatoes, cilantro, and garlic.",
      "group": null
    },
    {
      "text": "Add 1 tablespoon of the reserved lime juice.",
      "group": null
    },
    {
      "text": "Let sit at room temperature for 1 hour and then serve.",
      "group": null
    }
