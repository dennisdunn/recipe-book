  "steps": [
    {
      "text": "Preheat oven to 350°F. Spray a 9-by-11-inch pan with cooking spray.",
      "group": null
    },
    {
      "text": "In a small bowl, use an electric mixer to mix almond butter, protein powder, and maple syrup. Beat in the eggs.",
      "group": null
    },
    {
      "text": "Stir in rolled oats, coconut, and baking soda, and mix well.",
      "group": null
    },
    {
      "text": "Firmly press stiff dough into the pan using the back of a spoon.",
      "group": null
    },
    {
      "text": "Bake for 12 minutes or until the top browns slightly.",
      "group": null
    },
    {
      "text": "Cool pan on a rack, cut into 18 squares, and store leftovers in an airtight container.",
      "group": null
    }
