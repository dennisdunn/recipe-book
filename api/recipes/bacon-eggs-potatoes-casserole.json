  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x9 inch casserole dish.",
      "group": null
    },
    {
      "text": "Layer hash browns in casserole dish, dot with butter and season with salt and pepper. Bake at 425 for 20 to 30 minutes.",
      "group": null
    },
    {
      "text": "Meanwhile, fry the bacon in a large, deep skillet over medium-high heat until evenly browned, about 10 minutes. Drain on a paper towel-lined plate. Crumble.",
      "group": null
    },
    {
      "text": "Layer bacon, cheese, onion and green pepper over potatoes. Season with salt and pepper.",
      "group": null
    },
    {
      "text": "In a large bowl beat together eggs and milk. Pour mixture over all.",
      "group": null
    },
    {
      "text": "Cover with aluminum foil and bake at 350 degrees for 45 minutes. Uncover and bake for another 30 minutes until eggs have set.",
      "group": null
    }
  ],
  "footnotes": [],
  "nutrition": null,
  "importedNotes": [
    {
      "text": "Original recipe recommended that you refrigerate it overnight (unbaked) and bake it in the morning. I made mine in the morning and baked it in the afternoon."
