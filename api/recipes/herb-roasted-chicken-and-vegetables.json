  "steps": [
    {
      "text": "Preheat oven to 425 degrees F.",
      "group": null
    },
    {
      "text": "Line a 13x9x2 pan with heavy duty foil.",
      "group": null
    },
    {
      "text": "Place chicken pieces in pan and brush with 1 TBSP olive oil.",
      "group": null
    },
    {
      "text": "Combine basil, rosemary and garlic salt in medium bowl.",
      "group": null
    },
    {
      "text": "Sprinkle ½ of the herb mixture on the chicken.",
      "group": null
    },
    {
      "text": "Add remaining olive oil, potatoes, carrots and onion to the bowl with the herb mixture and stir to coat.",
      "group": null
    },
    {
      "text": "Arrange vegetables in an even layer around the chicken.",
      "group": null
    },
    {
      "text": "Cover dish with sheet of foil and fold back one edge for heat circulation.",
      "group": null
    },
    {
      "text": "Bake 45 to 50 minutes or until vegetables are done and meat thermometer reads 170 degree for white met and 180 for dark meat.",
      "group": null
    },
    {
      "text": "Carefully remove cover.",
      "group": null
    },
    {
      "text": "Remove foil. Flip pan upright and drop foil inside. Crimp edges to rim of pan.",
      "group": null
    }
  ],
  "footnotes": [
    "To line pan, flip pan upside down. Press a sheet of foil around the pan."
  ],
