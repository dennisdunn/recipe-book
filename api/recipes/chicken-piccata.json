  "steps": [
    {
      "text": "Sprinkle filets with salt and pepper.",
      "group": null
    },
    {
      "text": "Dust with flour, shaking off excess.",
      "group": null
    },
    {
      "text": "Heat 1 TBSP oil in skillet over medium-high heat.",
      "group": null
    },
    {
      "text": "Add the filets and sauté 2-3 minutes on each side until golden brown and cooked to internal temp of 165 degrees.",
      "group": null
    },
    {
      "text": "Remove and set aside.",
      "group": null
    },
    {
      "text": "Add remaining oil, garlic and mushrooms to skillet and sauté until mushrooms are browned.",
      "group": null
    },
    {
      "text": "Add chicken broth and heat to boiling, scraping to loosen browned bits from pan,",
      "group": null
    },
    {
      "text": "Simmer 2 minutes. Stir in lemon juice and butter.",
      "group": null
    },
    {
      "text": "Return cooked filets to skillet. Heat through, turning to coat with sauce.",
      "group": null
    },
    {
      "text": "Serve and refrigerate leftovers.",
      "group": null
    }
  ],
