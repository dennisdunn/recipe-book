  "steps": [
    {
      "text": "Whisk the oil, soy sauce, honey, vinegar, garlic powder and ginger in a bowl.",
      "group": null
    },
    {
      "text": "Stir in the green onions.",
      "group": null
    },
    {
      "text": "Pour over the steak in a shallow dish, turning to coat.",
      "group": null
    },
    {
      "text": "Marinate covered in frig for 12 hours, turning occasionally.",
      "group": null
    },
    {
      "text": "Drain and discard marinate.",
      "group": null
    },
    {
      "text": "Preheat grill:",
      "group": null
    },
    {
      "text": "Grill steak directly over medium heat, turning once, until a meat thermometer registers 145 F. for medium rare (about 5 minutes per side).",
      "group": null
    },
    {
      "text": "Let stand for 5 minutes.",
      "group": null
    },
    {
      "text": "Slice diagonally against the grain into thin strips.",
      "group": null
    },
    {
      "text": "Serve with Mexican Corn Salad (see separate recipe).",
      "group": null
    },
    {
      "text": "TIP: This marinade works well with other cuts of steak, chicken breasts and",
      "group": null
    },
    {
      "text": "hearty fish like salmon.",
      "group": null
    }
