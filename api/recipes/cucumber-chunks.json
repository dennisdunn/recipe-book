  "steps": [
    {
      "text": "Scrub the cukes, cut off the stem end and tip. Cut in half lengthwise, then into quarters lengthwise. Cut away the seeds. Cut into small chunks.",
      "group": null
    },
    {
      "text": "Add diced green pepper and onion. Follow the instructions for basic brining for 3 to 4 hours.",
      "group": null
    },
    {
      "text": "Mix up a simple bread and butter pickle syrup: equal parts water and vinegar, a couple cups sugar, some pickling spice. Bring to a gentle boil. Add the drained cucumber chunks.",
      "group": null
    },
    {
      "text": "Bring to a boil, then remove from heat. Portion into clean jars. Cool and store in the fridge, or process in a cold water bath canner to store in the pantry.",
      "group": null
    }
  ],
