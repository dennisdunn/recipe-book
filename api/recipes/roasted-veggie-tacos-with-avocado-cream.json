  "steps": [
    {
      "text": "Preheat oven to 425 F.",
      "group": null
    },
    {
      "text": "Combine veggies, tomatoes and black  beans in a large bowl.",
      "group": null
    },
    {
      "text": "In a small bowl, whisk together olive oil, garlic, salt and cumin.",
      "group": null
    },
    {
      "text": "Toss with veggie mixture to coat & spread evenly in a lg roasting pan.",
      "group": null
    },
    {
      "text": "Roast, stirring every 10 mins until veggies are cooked thru & browned.",
      "group": null
    },
    {
      "text": "In a serving bowl, mash avocado, sour cream and lime juice until smooth and stir in cilantro to taste.",
      "group": null
    },
    {
      "text": "Warm tortillas and fill with veggies and avocado cream and top with cheese and cilantro.",
      "group": null
    }
