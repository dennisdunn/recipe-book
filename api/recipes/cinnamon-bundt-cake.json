  "steps": [
    {
      "text": "Preheat oven to 350 degrees.",
      "group": null
    },
    {
      "text": "Combine all cake ingredients and mix with hand mixer for 1 minute.",
      "group": null
    },
    {
      "text": "Pour half of the cake mixture into a greased bundt pan.",
      "group": null
    },
    {
      "text": "Pour second layer of cinnamon mix onto on top.",
      "group": null
