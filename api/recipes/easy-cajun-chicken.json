    {
      "text": "Rub the chicken with olive oil.",
      "group": null
    },
    {
      "text": "Add Cajun seasoning and toss until chicken is fully coated.",
      "group": null
    },
    {
      "text": "Spread the chicken out on cookie sheets with at least an inch between pieces.",
      "group": null
    },
    {
      "text": "Bake in the center of a preheated 400 degree (F) oven for about 50 minutes (40 minutes for wings). The skin should be golden and crispy, and the juices should run clear.",
