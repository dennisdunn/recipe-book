  "steps": [
    {
      "text": "Dry wing pieces with paper towels to remove excess liquid.",
      "group": null
    },
    {
      "text": "Place wings in a large bowl and rub olive oil evenly into each piece.",
      "group": null
    },
    {
      "text": "Combine all seasonings in a bowl.",
      "group": null
    },
    {
      "text": "Sprinkle half of the season mix onto the chicken wings and rub in.",
      "group": null
    },
    {
      "text": "Flip wings and sprinkle remaining half onto wings and rub in.",
      "group": null
    },
    {
      "text": "Place rack over shallow baking pan with sides (line pan with foil for",
      "group": null
    },
    {
      "text": "easy cleanup). Place seasoned wings on rack.",
      "group": null
    },
    {
      "text": "Bake at 350 degrees °F for 20 minutes, flip each wing, then bake for",
      "group": null
    },
    {
      "text": "an additional 10 minutes.",
      "group": null
    },
    {
      "text": "Turn oven broiler on low and broil for another 10 minutes.",
      "group": null
    },
    {
      "text": "Remove from oven. Serve with celery and blue cheese dressing if",
      "group": null
    },
    {
      "text": "desired.",
      "group": null
    },
