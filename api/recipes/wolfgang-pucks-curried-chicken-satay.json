  "steps": [
    {
      "text": "Soak bamboo skewers in water for 30 minutes",
      "group": null
    },
    {
      "text": "Thinly slice breast lengthwise, thread lengthwise thru skewers",
      "group": null
    },
    {
      "text": "Combine curry, cumin, ½ tsp salt and 1 tsp pepper",
      "group": null
    },
    {
      "text": "Brush chicken with peanut oil & sprinkle with dry ingredients",
      "group": null
    },
    {
      "text": "Refrigerator 1 hour",
      "group": null
    },
    {
      "text": "In food processor, combine rice vinegar, mayo, soy, mint, coriander, ¼ tsp salt and ¼ tsp pepper.",
      "group": null
    },
    {
      "text": "With machine on, drizzle in ½ c peanut oil & process until smooth.",
      "group": null
    },
    {
      "text": "Transfer vinegarette into dipping bowls & refrigerate until ready to serve",
      "group": null
    },
    {
      "text": "Preheat stovetop grill over high heat. Grill skewers turning once until cooked and browned, about 2 minutes per side.",
      "group": null
    },
    {
      "text": "Serve with vinegarette.",
      "group": null
    }
  ],
