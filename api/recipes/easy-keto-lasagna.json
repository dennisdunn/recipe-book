  "steps": [
    {
      "text": "Preheat oven to 375",
      "group": null
    },
    {
      "text": "Grate fresh cauliflower or use prepared bag of cauliflower rice. Brown over medium heat in a skillet and drain all excess liquid using cheese cloth or towel.",
      "group": null
    },
    {
      "text": "Mix eggs, mozzarella, grated Parmesan, and seasoning in large bowl with cauliflower rice",
      "group": null
    },
    {
      "text": "Spread cauliflower rice mixture out like a pizza crust, about 1/4-1/2 inch thick on lined baking sheet",
      "group": null
    },
    {
      "text": "Bake for 15 minutes or until golden brown, set aside",
      "group": null
    },
    {
      "text": "Meat sauce (while cauliflower layer bakes)",
      "group": null
    },
    {
      "text": "Brown ground beef in skillet, drain fat, and add alfredo sauce and raw spinach. Reduce heat and continue cooking until spinach is wilted, set aside",
      "group": null
    },
    {
      "text": "Ricotta filling",
      "group": null
    },
    {
      "text": "Mix ricotta, grated parmesan, heavy whipping cream and seasoning together, set aside",
      "group": null
    },
    {
      "text": "Assembly",
      "group": null
    },
    {
      "text": "Oven at 375",
      "group": null
    },
    {
      "text": "Prepare an 8×8 baking dish with non stick spray",
      "group": null
    },
    {
      "text": "Cut cauliflower sheet into 2 halves and trim to fit the pan",
      "group": null
    },
    {
      "text": "Place one layer of cauliflower on the bottom of the pan (I had to trim mine a little)",
      "group": null
    },
    {
      "text": "Place half of meat sauce on top of layer, adding a couple additional tsps of alfredo if needed",
      "group": null
    },
    {
      "text": "Add half of ricotta mixture on top of meat sauce layer and sprinkle 1/4 cup mozzarella",
      "group": null
    },
    {
      "text": "Place second half of cauliflower layer and repeat last two previous steps with mozzarella on top",
      "group": null
    },
    {
      "text": "Bake for 20 minutes until bubbling then broil for 3-5 minutes to brown cheese",
      "group": null
    },
    {
      "text": "Nutrition: 1/6 of Pan, Calories: 333, Fat: 26, Carbohydrates: 5 Total, 4 Net, Protein: 27",
      "group": null
    }
