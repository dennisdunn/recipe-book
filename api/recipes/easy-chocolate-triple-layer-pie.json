  "steps": [
    {
      "text": "In a large bowl, mix milk and pudding. Beat with wire whisk for 1 minute. Spoon 1 1/2 cups of pudding into graham cracker crust.",
      "group": null
    },
    {
      "text": "Gently fold in 1/2 of the whipped topping into remaining pudding. Spread this mixture over the pudding layer in crust. Top with remaining whipped topping. Garnish with chocolate shavings and cover and refrigerate for 4 hours.",
      "group": null
    }
