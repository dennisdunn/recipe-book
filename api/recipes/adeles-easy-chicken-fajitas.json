  "steps": [
    {
      "text": "Keep chicken frozen until ready to prepare dinner. Place chicken in 2 gallon zip lock bags for marinating. Combine Taco seasonings, oil and water and pour half into each bag. Let sit for 30 minutes while chopping veggies. Flip bag over from time to time to spread marinade.",
      "group": null
    },
    {
      "text": "Cut peppers in half, then cut into long, thin strips. Cut onion in half, then slice. Buy carrots already slivered.",
      "group": null
    },
    {
      "text": "Pour chicken and marinade into large skillet. Cook on medium heat until chicken is hot and sauce is absorbed. Keep warm while cooking veggies",
      "group": null
    },
    {
      "text": "Saute onions in small amount of olive oil until onions are translucent but not browned. Remove and set aside. Saute peppers and carrots until tender but still brightly colored and not limp. Stir in onions and serve before veggies are overcooked.",
      "group": null
    },
    {
      "text": "Serve buffet style so guests can choose their own toppings.",
      "group": null
    }
  ],
