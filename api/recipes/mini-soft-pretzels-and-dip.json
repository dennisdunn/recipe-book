  "steps": [
    {
      "text": "Heat oven to 375°F. Unroll dough; separate into 12 breadsticks. Cut each in half. Roll each breadstick lightly to form 10-inch-long rope.",
      "group": null
    },
    {
      "text": "To shape each pretzel, shape rope into a circle, overlapping dough about 2 inches from each end, leaving ends free. Take 1 end in each hand; twist once at point where dough overlaps. Lift ends over opposite side of circle.",
      "group": null
    },
    {
      "text": "Place 1 inch apart on ungreased cookie sheet. Brush each with beaten egg; sprinkle with Kosher salt.",
      "group": null
    },
    {
      "text": "Bake 13 to 15 minutes or until golden brown.",
      "group": null
    },
    {
      "text": "Meanwhile, in small microwavable bowl, mix cheese spread and milk.",
      "group": null
    },
    {
      "text": "Microwave on high 1 min, stirring once halfway through cooking, until melted and hot.",
      "group": null
    },
    {
      "text": "Remove pretzels from cookie sheet. Serve warm pretzels with warm cheese dip.",
      "group": null
    }
  ],
