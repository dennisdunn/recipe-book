  "steps": [
    {
      "text": "Preheat oven to 350 degrees.",
      "group": null
    },
    {
      "text": "Heat the butter and oil in a flame-proof casserole or Dutch oven.  Brown the pork cubes, a few at a time, remove and reserve.",
      "group": null
    },
    {
      "text": "Discard all but 2 tablespoons fat from casserole. Add onions and garlic; cook until lightly browned.",
      "group": null
    },
    {
      "text": "Add salt, pepper and flour, stirring until blended.",
      "group": null
    },
    {
      "text": "Add chili powder, cumin, marjoram, tomatoes and wine. Bring to boiling, cook 2 to 3 minutes stirring constantly.",
      "group": null
    },
    {
      "text": "Return pork to casserole and add the bay leaf. Cover casserole and place in center of oven. Cook for 1 and ½ hours or until meat is tender.",
      "group": null
    },
    {
      "text": "Remove casserole from oven and carefully degrease the stew.",
      "group": null
    },
    {
      "text": "Add the beans and simmer on top of the stove until beans are heated through.",
      "group": null
    },
    {
      "text": "Taste and add additional seasonings as desired.",
      "group": null
    },
    {
      "text": "Note: This kind of stew can be made one or two days ahead of time. Let it cool and degrease thoroughly. Reheat it in a slow oven before serving.",
      "group": null
    }
  ],
