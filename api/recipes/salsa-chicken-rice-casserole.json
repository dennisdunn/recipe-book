  "steps": [
    {
      "text": "Place rice and water in a saucepan, and bring to a boil. Reduce heat to low, cover, and simmer for 20 minutes.",
      "group": null
    },
    {
      "text": "Brown chicken in olive oil with southwestern seasoning, onion and garlic. When cool enough to handle, cut meat into bite-size pieces.",
      "group": null
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 inch baking dish.",
      "group": null
    },
    {
      "text": "In a medium bowl, combine Monterey Jack and Cheddar cheeses. In a separate bowl, mix together chicken soup, onion, and salsa. Layer 1/2 of the rice, 1/2 of the chicken, 1/2 of the soup and salsa mixture, and 1/2 of the cheese mixture in prepared dish. Repeat layers, ending with cheese.",
      "group": null
    },
    {
      "text": "Cover with foil and bake in preheated oven for about 30 minutes. Remove foil and bake another 10 minutes (to keep cheese stringing rather than crunchy).",
      "group": null
    },
    {
      "text": "Top off each serving with dollop of sour cream and spoonful of salsa.",
      "group": null
    }
  ],
