  "steps": [
    {
      "text": "In a large stock pot saute celery and onion in butter.",
      "group": null
    },
    {
      "text": "Add potatoes, chicken bouillon, water and parsley flakes.",
      "group": null
    },
    {
      "text": "Season with salt and pepper",
      "group": null
    },
    {
      "text": "Simmer until vegetables become tender.",
      "group": null
    },
    {
      "text": "In a separate bowl mix flour and milk. Once it is well blended, add to soup mixture and cook until soup becomes thick.",
      "group": null
    },
    {
      "text": "Stir in cheese and cooked ham (smoked sausage) and simmer until cheese is melted.",
      "group": null
    },
    {
      "text": "Garnish with green onions, shredded cheese and crumbled bacon.",
      "group": null
    }
  ],
