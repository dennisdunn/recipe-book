  "steps": [
    {
      "text": "Place 1 in. of water in a small saucepan; add broccoli. Bring to a boil. Reduce heat; cover and simmer for 2-3 minutes; rinse in cold water and drain. In a large bowl, combine the broccoli, pasta, carrots, peas, pepperoni, cheese and onions.",
      "group": null
    },
    {
      "text": "In another bowl, combine the dressing ingredients. Pour over salad and toss to coat. Cover and refrigerate overnight.",
      "group": null
    }
