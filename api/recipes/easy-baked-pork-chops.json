  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "group": null
    },
    {
      "text": "Season pork chops with Old Bay (check sodium content before adding salt), salt and pepper to taste. Melt the butter in a large skillet over medium high heat. Sautee pork chops until brown, about 5 minutes per side.",
      "group": null
    },
    {
      "text": "Sautee onion slices, mushrooms and garlic in pan drippings.",
      "group": null
    },
    {
      "text": "In a separate medium bowl, combine the milk, soup and Kitchen Bouquet for coloring.",
      "group": null
    },
    {
      "text": "Place the pork chops in a 9x13 inch baking dish and pour the soup mixture over the chops.",
      "group": null
    },
    {
      "text": "Bake at 275 F for 2 hours.",
      "group": null
    }
  ],
  "footnotes": [],
  "nutrition": null,
  "importedNotes": [
    {
      "text": "Option:  add a package of pork gravy mix and a cup of water to the soup, and some Old Bay and onion powder, then poured it over the chops to bake."
    },
    {
      "text": "My basic pork chop philosophy is low and slow. I cooked the chops at 275 degrees for 3 hours. They were extremely tender and flavorful."
    }
