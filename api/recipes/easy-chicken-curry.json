  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Brown chicken in olive oil.",
      "group": null
    },
    {
      "text": "In separate plan, sauté onion until soft and golden brown. Add mushrooms and peas to onion and when heated, add curry, pepper flakes, chicken broth and coconut milk.",
      "group": null
    },
    {
      "text": "Once ingredients are blended together, add chicken breasts. Cover and simmer over medium low heat for about 45 minutes until chicken is no longer pink inside.",
      "group": null
    },
    {
      "text": "Remove cover from skillet and cook for an additional 15 minutes, until sauce reduces. (Note: Make sure that you stir and that dish does not burn, as curry powder burns very easily!)",
      "group": null
    },
    {
      "text": "Serve over Texmati rice and serve with a side of mango chutney.",
      "group": null
    }
  ],
