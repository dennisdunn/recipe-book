  "steps": [
    {
      "text": "In a large bowl, combine the first eight ingredients; mix well.",
      "group": null
    },
    {
      "text": "In a saucepan, cook oil, brown sugar, honey, water and vanilla until sugar is dissolved.",
      "group": null
    },
    {
      "text": "Pour over dry ingredients and mix well.",
      "group": null
    },
    {
      "text": "Spoon to a greased 13-in. x 9-in. x 2-in. baking pan.",
      "group": null
    },
    {
      "text": "Bake at 275 degrees F for 1 hour or until golden, stirring every 15 minutes.",
      "group": null
    },
    {
      "text": "Cool completely. Stir in raisins or apricots.",
      "group": null
    }
