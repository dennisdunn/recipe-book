  "steps": [
    {
      "text": "Preheat oven to 400 F.",
      "group": null
    },
    {
      "text": "Combine bread crumbs, Italian seasoning and garlic powder in shallow dish.",
      "group": null
    },
    {
      "text": "Dip chicken in egg, then crumb mixture, turn to coat.",
      "group": null
    },
    {
      "text": "Arrange chicken in 13 x 9 inch baking dish.",
      "group": null
    },
    {
      "text": "Bake 20 minutes.",
      "group": null
    },
    {
      "text": "Pour pasta sauce over middle of chicken (don’t drown it) and sprinkle cheese on top of sauce.",
      "group": null
    },
    {
      "text": "Bake an additional 10 minutes or until internal chicken temp is 165 F.",
      "group": null
    }
