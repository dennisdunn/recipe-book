  "steps": [
    {
      "text": "Preheat oven to 375 degrees F and grease cookie sheets.",
      "group": null
    },
    {
      "text": "In separate bowl, sift together flour, baking powder, baking soda and salt. Set aside.",
      "group": null
    },
    {
      "text": "In a large bowl, cream together shortening and both sugars until light and fluffy, using electric mixer at medium speed.",
      "group": null
    },
    {
      "text": "Add eggs, one at a time, beating well after each. Blend in vanilla.",
      "group": null
    },
    {
      "text": "Gradually add dry ingredients to creamed mixture, mixing well with spoon.",
      "group": null
    },
    {
      "text": "Stir in oats, dates and walnuts.",
      "group": null
    },
    {
      "text": "Drop dough by teaspoonfuls, about 2 inches apart, on cookie sheet.",
      "group": null
    },
    {
      "text": "Bake for 8 minutes or until lightly browned. Remove from cookie sheets to cool on racks.",
      "group": null
    }
  ],
