  "steps": [
    {
      "text": "Crumble sausage in skillet and cook over medium-low heat.",
      "group": null
    },
    {
      "text": "Add onion and cook until tender; drain. Add gluten free flour to make a roux and cook for about 6 minutes or until bubbly and golden.",
      "group": null
    },
    {
      "text": "Stir in milk ½ cup at a time to get desired consistency.",
      "group": null
    },
    {
      "text": "Add Worcestershire sauce, hot pepper sauce, nutmeg (optional) and poultry seasoning (optional) and cook until thick.",
      "group": null
